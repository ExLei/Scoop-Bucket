{
    "version": "11.32.0",
    "description": "PDF24 Creator - 免费离线的 PDF 工具箱，集成合并、拆分、压缩、转换、OCR、阅读器等工具（PDF 虚拟打印机需管理员权限安装）| Offline PDF toolbox with merge, split, compress, convert, OCR and reader tools",
    "homepage": "https://tools.pdf24.org/creator",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.pdf24.org/en/terms-of-use"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.pdf24.org/pdf24-creator-11.32.0-x64.exe",
            "hash": "e231ec4fd8102608a0d329d96243f656ca05c22859386d034ef62c06f3129e3e"
        },
        "arm64": {
            "url": "https://download.pdf24.org/pdf24-creator-11.32.0-arm64.exe",
            "hash": "46a73ab1cf7973b16561bd18bfff95e82834b23c583560b09ab29977f25e408f"
        }
    },
    "installer": {
        "script": "Expand-InnoArchive \"$dir\\$fname\" -Removal"
    },
    "uninstaller": {
        "script": [
            "# 结束进程（终止后等待文件句柄释放，避免文件锁定导致卸载失败）",
            "Stop-Process -Name 'pdf24', 'pdf24-Toolbox', 'pdf24-Creator', 'pdf24-Reader', 'pdf24-Launcher', 'pdf24-Ocr', 'pdf24-Compress', 'pdf24-DocTool', 'pdf24-Assistant', 'pdf24-Fax', 'pdf24-Settings', 'pdf24-Updater', 'pdf24-wpp' -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500"
        ]
    },
    "shortcuts": [
        [
            "pdf24-Toolbox.exe",
            "..\\PDF24-工具箱"
        ]
    ],
    "persist": "tesseract\\tessdata",
    "notes": "本安装不注册 PDF 虚拟打印机，可在 PDF24 设置 (pdf24-Settings.exe) 中添加 PDF 打印机，该操作需要管理员权限。",
    "checkver": {
        "url": "https://creator.pdf24.org/listVersions.php",
        "regex": "<td>([\\d.]+)</td>\\s*<td>x64</td>\\s*<td>EXE</td>"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.pdf24.org/pdf24-creator-$version-x64.exe",
                "hash": {
                    "url": "https://creator.pdf24.org/listVersions.php",
                    "regex": "<td>$version</td>\\s*<td>x64</td>\\s*<td>EXE</td>\\s*<td><a href=\"[^\"]*\">[^<]*</a></td>\\s*<td>([0-9A-F]{64})</td>"
                }
            },
            "arm64": {
                "url": "https://download.pdf24.org/pdf24-creator-$version-arm64.exe",
                "hash": {
                    "url": "https://creator.pdf24.org/listVersions.php",
                    "regex": "<td>$version</td>\\s*<td>arm64</td>\\s*<td>EXE</td>\\s*<td><a href=\"[^\"]*\">[^<]*</a></td>\\s*<td>([0-9A-F]{64})</td>"
                }
            }
        }
    }
}

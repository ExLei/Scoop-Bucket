        }
    },
    "pre_install": [
        "# 为 Settings.json 创建空文件占位，防止 Scoop 将 persist 链接创建为文件夹",
        "if (!(Test-Path \"$dir\\Settings.json\")) { New-Item -ItemType File \"$dir\\Settings.json\" -Force | Out-Null }",
        "# 确保 Presets 和 Plugin 是目录",
        "if (!(Test-Path \"$dir\\Presets\")) { New-Item -ItemType Directory \"$dir\\Presets\" -Force | Out-Null }",
        "if (!(Test-Path \"$dir\\Plugin\")) { New-Item -ItemType Directory \"$dir\\Plugin\" -Force | Out-Null }"
    ],
    "shortcuts": [
        ["FFmpegFreeUI.exe", "..\\FFmpegFreeUI"]
    ],
    "persist": [
        "Settings.json",
        "Presets",
        "Plugin"
    ],
    "checkver": {
        "github": "https://github.com/Lake1059/FFmpegFreeUI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/$version/FFmpegFreeUI.SingleFile.x64.7z",

            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/5.2/FFmpegFreeUI.SingleFile.x64.7z",
            "hash": "a12fe6b940f1cb618d1fbdccb407db65b0f98abeecda752e58598c4dbb5b607d",
            "extract_dir": "FFmpegFreeUI SingleFile x64"
        }
    },
    "pre_install": [
        "# 为 Settings.json 创建 JSON 对象占位，防止 Scoop 将 persist 链接创建为文件夹",
        "if (!(Test-Path \"$dir\\Settings.json\")) { Set-Content \"$dir\\Settings.json\" '{}' -Encoding ASCII }",
        "# 修复已存在的空 Settings.json（首次安装时创建的空文件导致 JSON 解析失败）",
        "if ((Get-Item \"$dir\\Settings.json\" -ErrorAction SilentlyContinue).Length -eq 0) { Set-Content \"$dir\\Settings.json\" '{}' -Encoding ASCII }",
        "# 确保 Presets 和 Plugin 是目录",
        "if (!(Test-Path \"$dir\\Presets\")) { New-Item -ItemType Directory \"$dir\\Presets\" -Force | Out-Null }",
        "if (!(Test-Path \"$dir\\Plugin\")) { New-Item -ItemType Directory \"$dir\\Plugin\" -Force | Out-Null }"
    ],
    "uninstaller": {
        "script": [
            "# 结束进程（终止后等待文件句柄释放，避免文件锁定导致卸载失败）",
            "Stop-Process -Name FFmpegFreeUI -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500"
        ]
    },
    "shortcuts": [
        ["FFmpegFreeUI.exe", "..\\FFmpegFreeUI"]
    ],
    "persist": [
        "Settings.json",
        "Presets",
        "Plugin"
    ],
    "checkver": {
        "github": "https://github.com/Lake1059/FFmpegFreeUI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/$version/FFmpegFreeUI.SingleFile.x64.7z",
                "extract_dir": "FFmpegFreeUI SingleFile x64"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}

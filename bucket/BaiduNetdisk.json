{
    "version": "8.4.8.102",
    "description": "百度网盘，百度的一款云存储客户端",
    "homepage": "https://pan.baidu.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://pan.baidu.com/disk/main#/protocol/duty_mobi"
    },
    "architecture": {
        "64bit": {
            "url": "https://issuepcdn.baidupcs.com/issue/netdisk/yunguanjia/BaiduNetdisk_8.4.8.102.exe#/dl.7z",
            "hash": "766c61c6fbfdc8bb84db44a9c90fe2d74d1e0797bdfaaf749af57d0ebc9f2b54"
        }
    },
    "pre_install": [
        "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\uninst.exe\" -Force -ErrorAction SilentlyContinue",
        "",
        "$dataDir = \"$env:APPDATA\\baidu\\BaiduNetdisk\"",
        "$persistDir = \"$persist_dir\\BaiduNetdisk_Data\"",
        "if (!(Test-Path $persistDir)) {",
        "    New-Item -ItemType Directory $persistDir -Force | Out-Null",
        "}",
        "if (Test-Path $dataDir) {",
        "    if ((Get-Item $dataDir -Force -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        [System.IO.Directory]::Delete($dataDir)",
        "    } else {",
        "        Get-ChildItem $dataDir | ForEach-Object {",
        "            $target = Join-Path $persistDir $_.Name",
        "            if (Test-Path $target) {",
        "                Copy-Item \"$($_.FullName)\\*\" $target -Recurse -Force -ErrorAction SilentlyContinue",
        "                Remove-Item $_.FullName -Recurse -Force",
        "            } else {",
        "                Move-Item $_.FullName $target",
        "            }",
        "        }",
        "        Remove-Item $dataDir -Recurse -Force",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path $dataDir -Target $persistDir | Out-Null",
        "",
        "$regPath = 'HKCU:\\SOFTWARE\\Classes\\baiduyunguanjia'",
        "$exePath = \"$(Split-Path $dir -Parent)\\current\\BaiduNetdisk.exe\"",
        "New-Item -Path \"$regPath\\shell\\open\\command\" -Force | Out-Null",
        "Set-ItemProperty -Path $regPath -Name '(default)' -Value 'BaiduNetdisk Protocol' -Type String",
        "Set-ItemProperty -Path $regPath -Name 'URL Protocol' -Value '' -Type String",
        "Set-ItemProperty -Path \"$regPath\\shell\\open\\command\" -Name '(default)' -Value \"`\"$exePath`\" `\"%1`\"\""
    ],
    "pre_uninstall": [
        "$dataDir = \"$env:APPDATA\\baidu\\BaiduNetdisk\"",
        "if (Test-Path $dataDir) {",
        "    if ((Get-Item $dataDir -Force -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        [System.IO.Directory]::Delete($dataDir)",
        "    }",
        "}"
    ],
    "uninstaller": {
        "script": [
            "Stop-Process -Name BaiduNetdisk -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500",
            "$appDir = Split-Path $dir -Parent",
            "$shell = New-Object -ComObject WScript.Shell",
            "@(\"$env:APPDATA\", \"$env:ProgramData\") | ForEach-Object {",
            "    $lnk = \"$_\\Microsoft\\Windows\\Start Menu\\Programs\\百度网盘.lnk\"",
            "    if ((Test-Path $lnk) -and ($shell.CreateShortcut($lnk).TargetPath -like \"$appDir\\*\")) {",
            "        Remove-Item $lnk -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "post_uninstall": [
        "Remove-Item 'HKCU:\\SOFTWARE\\Classes\\baiduyunguanjia' -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "BaiduNetdisk.exe",
            "..\\百度网盘"
        ]
    ],
    "persist": "BaiduNetdisk_Data",
    "checkver": {
        "github": "https://github.com/ExLei/BaiduNetdisk-windows-Updater"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ExLei/BaiduNetdisk-windows-Updater/releases/download/v$version/BaiduNetdisk_$version.exe#/dl.7z"
            }
        }
    }
}

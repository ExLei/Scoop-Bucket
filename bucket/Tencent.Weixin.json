{
    "version": "4.1.10.27",
    "description": "微信，腾讯的一款聊天通讯工具 | A chat communication tool by Tencent",
    "homepage": "https://www.wechat.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.wechat.com/zh_CN/service_terms.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://dldir1v6.qq.com/weixin/Universal/Windows/WeChatWin_4.1.10.exe#/dl.7z",
            "hash": "54203fc2b41983fa106b0af0d67f86befc56ccd3dc1005d4bab6de8ea36b4f74"
        }
    },
    "pre_install": [
        "# 解压 NSIS 中内嵌的 install.7z",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\install\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Expand-7zipArchive \"$dir\\install.7z\" \"$dir\"",
        "Remove-Item \"$dir\\install.7z\" -Force",
        "# WeChat 4.x 需要版本子目录结构（如 4.1.10.27/），launcher 从中加载 DLL",
        "# 仅将 Weixin.exe 和 Uninstall.exe 提到根目录，其余文件保留在版本子目录",
        "$verDir = Get-ChildItem \"$dir\" -Directory | Where-Object { $_.Name -match '^\\d+[\\.\\d]+$' } | Select-Object -First 1",
        "if ($verDir) {",
        "    Move-Item \"$verDir\\Weixin.exe\" \"$dir\" -Force -ErrorAction SilentlyContinue",
        "    Move-Item \"$verDir\\Uninstall.exe\" \"$dir\" -Force -ErrorAction SilentlyContinue",
        "}",
        "# 删除安装器辅助文件",
        "Remove-Item \"$dir\\FindProcDLL.dll\", \"$dir\\nsis7z.dll\", \"$dir\\System.dll\", \"$dir\\WeChatInstallDll.dll\" -Force -ErrorAction SilentlyContinue",
        "",
        "# 注册 weixin:// 协议（每次安装/更新都刷新，指向 current 路径）",
        "$regPath = \"HKCU:\\Software\\Classes\\weixin\"",
        "$exePath = \"$(Split-Path $dir -Parent)\\current\\Weixin.exe\"",
        "New-Item -Path \"$regPath\\shell\\open\\command\" -Force | Out-Null",
        "Set-ItemProperty -Path $regPath -Name '(default)' -Value 'WeChat Protocol' -Type String",
        "Set-ItemProperty -Path $regPath -Name 'URL Protocol' -Value '' -Type String",
        "Set-ItemProperty -Path \"$regPath\\shell\\open\\command\" -Name '(default)' -Value \"`\"$exePath`\" `\"%1`\"\"",
        "",
        "# 数据目录：将 Documents\\xwechat_files 映射到 persist 目录",
        "$persistDataDir = \"$persist_dir\\xwechat_files\"",
        "$dataDir = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'xwechat_files'",
        "if (Test-Path $dataDir) {",
        "    if ((Get-Item $dataDir -Force -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        [System.IO.Directory]::Delete($dataDir)",
        "    } else {",
        "        if (!(Test-Path $persistDataDir)) {",
        "            Move-Item $dataDir $persistDataDir -Force",
        "        } else {",
        "            Get-ChildItem $dataDir | Move-Item -Destination $persistDataDir -Force",
        "            Remove-Item $dataDir -Force -Recurse",
        "        }",
        "    }",
        "}",
        "# 确保 persist 数据目录存在，再创建 junction",
        "if (!(Test-Path $persistDataDir)) {",
        "    New-Item -ItemType Directory $persistDataDir -Force | Out-Null",
        "}",
        "New-Item -ItemType Junction -Path $dataDir -Target $persistDataDir | Out-Null"
    ],
    "post_install": [
        "# 确保数据目录映射存在",
        "$persistDataDir = \"$persist_dir\\xwechat_files\"",
        "$dataDir = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'xwechat_files'",
        "# 确保 persist 数据目录存在",
        "if (!(Test-Path $persistDataDir)) {",
        "    New-Item -ItemType Directory $persistDataDir -Force | Out-Null",
        "}",
        "if (Test-Path $dataDir) {",
        "    if ((Get-Item $dataDir -Force -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        [System.IO.Directory]::Delete($dataDir)",
        "    } else {",
        "        # 真实目录 → 迁移已有数据到 persist 目录",
        "        Get-ChildItem $dataDir | Move-Item -Destination $persistDataDir -Force",
        "        Remove-Item $dataDir -Force -Recurse",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path $dataDir -Target $persistDataDir | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "# 结束微信进程（终止后等待文件句柄释放）",
            "Stop-Process -Name Weixin -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500",
            "# 清理开始菜单快捷方式残留（校验目标路径指向本应用目录，避免误删同名非 Scoop 快捷方式）",
            "$appDir = Split-Path $dir -Parent",
            "$shell = New-Object -ComObject WScript.Shell",
            "@(\"$env:APPDATA\", \"$env:ProgramData\") | ForEach-Object {",
            "    $lnk = \"$_\\Microsoft\\Windows\\Start Menu\\Programs\\微信.lnk\"",
            "    if ((Test-Path $lnk) -and ($shell.CreateShortcut($lnk).TargetPath -like \"$appDir\\*\")) {",
            "        Remove-Item $lnk -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "pre_uninstall": [
        "# 删除 Documents 目录联接（保留数据）",
        "$dataDir = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'xwechat_files'",
        "if ((Test-Path $dataDir) -and ((Get-Item $dataDir -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {",
        "    [System.IO.Directory]::Delete($dataDir)",
        "}"
    ],
    "post_uninstall": [
        "# 清理 weixin:// 协议注册",
        "Remove-Item \"HKCU:\\Software\\Classes\\weixin\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        ["Weixin.exe", "..\\微信"]
    ],
    "notes": [
        "微信安装在 Scoop 管理的目录中，数据存储位置：",
        "  Documents\\xwechat_files（已映射到 persist 目录）",
        "",
        "weixin:// 协议链接已在安装/更新时自动注册，无需额外操作"
    ],
    "checkver": {
        "script": [
            "$stdout = & { winget show --exact --id Tencent.WeChat.Universal --source winget --accept-source-agreements } 2>&1 | Where-Object { $_ -is [string] } | Out-String",
            "if ($stdout -match 'Version:\\s*([\\d.]+)') { $ver = $matches[1] }",
            "if ($stdout -match 'Installer Url:\\s*(\\S+)') { $url = $matches[1] }",
            "if ($stdout -match 'Installer SHA256:\\s*([A-Fa-f0-9]+)') { $sha = $matches[1].ToLower() }",
            "Write-Output \"ver:$ver;x64:$url;sha256:$sha\""
        ],
        "regex": "ver:(?<version>[^;]+);x64:(?<x64>[^;]+);sha256:(?<sha256>[^;]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64#/dl.7z",
                "hash": "$matchSha256"
            }
        }
    }
}

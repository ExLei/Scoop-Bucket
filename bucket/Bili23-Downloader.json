{
    "version": "2.00.6",
    "description": "Bili23-Downloader - 开源、免费、跨平台的 B 站视频下载工具，支持多线程加速、音视频分离、弹幕元数据获取、自定义命名与分类等功能 | Open Source, Free, Cross-Platform Bilibili Video Downloader",
    "homepage": "https://bili23.scott-sloan.cn/",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/ScottSloan/Bili23-Downloader/blob/main/LICENSE"
    },
    "notes": [
        "数据持久化: 应用配置/config.json、任务列表/task.db、缩略图缓存/thumbnail.db 等数据",
        "已通过目录链接 (junction) 重定向到 Scoop persist 目录。",
        "卸载时不会残留数据，重新安装自动恢复。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ScottSloan/Bili23-Downloader/releases/download/v2.00.6/Bili23-Downloader_2.00.6_windows_x64_portable.zip",
            "hash": "6dc69f3c6f3b49428c2a5c6e9c7dc4697ad9e5a1f2bbda23da393ce7f0587353",
            "extract_dir": "Bili23-Downloader"
        }
    },
    "pre_install": [
        "# 确保数据目录存在（persist 恢复后应已存在，保底创建）",
        "if (!(Test-Path \"$dir\\data\")) { New-Item -ItemType Directory -Force -Path \"$dir\\data\" | Out-Null }",
        "",
        "# 迁移 %APPDATA% 中已有数据（首次安装时，从非 Scoop 旧版迁移）",
        "if (Test-Path \"$env:APPDATA\\Bili23 Downloader\") {",
        "    $item = Get-Item \"$env:APPDATA\\Bili23 Downloader\"",
        "    if (-not $item.LinkType) {",
        "        Write-Host \"迁移 %APPDATA%\\Bili23 Downloader 已有数据到 persist 目录...\"",
        "        Get-ChildItem \"$env:APPDATA\\Bili23 Downloader\" | Move-Item -Destination \"$dir\\data\" -Force",
        "        Remove-Item \"$env:APPDATA\\Bili23 Downloader\" -Recurse -Force",
        "    }",
        "}",
        "",
        "# 创建/更新 junction：%APPDATA% → persist 目录",
        "New-Item -ItemType Junction -Path \"$env:APPDATA\\Bili23 Downloader\" -Target \"$dir\\data\" -Force | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "# 安全删除目录联接（使用 .NET API，不穿透到目标目录）",
            "$junction = \"$env:APPDATA\\Bili23 Downloader\"",
            "if ((Test-Path $junction) -and ((Get-Item $junction -Force -ErrorAction SilentlyContinue).LinkType -eq 'Junction')) {",
            "    [System.IO.Directory]::Delete($junction)",
            "}"
        ]
    },
    "bin": "Bili23.exe",
    "shortcuts": [
        ["Bili23.exe", "..\\Bili23 下载器"]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/ScottSloan/Bili23-Downloader"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ScottSloan/Bili23-Downloader/releases/download/v$version/Bili23-Downloader_$version_windows_x64_portable.zip",
                "extract_dir": "Bili23-Downloader"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}

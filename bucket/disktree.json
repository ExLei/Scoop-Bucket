{
    "version": "0.11.0",
    "description": "disktree - 基于 Rust + GPUI 的磁盘空间可视化工具，以树状图展示目录占用、标记可回收内容并安全删除 | A treemap disk usage viewer built with Rust and GPUI that finds what is filling a disk, marks what should go, and removes it",
    "homepage": "https://github.com/tobi/disktree",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/tobi/disktree/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/tobi/disktree/releases/download/v0.11.0/disktree-0.11.0-x86_64-windows.zip",
            "hash": "1518cb5dde00deefc03c05d8a347d4674f7b6a120d9176a14482757883b6fbe7",
            "extract_dir": "disktree-0.11.0-x86_64-windows"
        },
        "arm64": {
            "url": "https://github.com/tobi/disktree/releases/download/v0.11.0/disktree-0.11.0-aarch64-windows.zip",
            "hash": "08e3ac215e8eaded2afea37b98d1ede0178e7332589b40609c9039354cbbf50a",
            "extract_dir": "disktree-0.11.0-aarch64-windows"
        }
    },
    "uninstaller": {
        "script": [
            "# 结束进程（终止后等待文件句柄释放，避免文件锁定导致卸载失败）",
            "Stop-Process -Name disktree -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500",
            "# 清理开始菜单快捷方式残留（校验目标路径指向本应用目录，避免误删同名非 Scoop 快捷方式）",
            "$appDir = Split-Path $dir -Parent",
            "$shell = New-Object -ComObject WScript.Shell",
            "@(\"$env:APPDATA\", \"$env:ProgramData\") | ForEach-Object {",
            "    $lnk = \"$_\\Microsoft\\Windows\\Start Menu\\Programs\\disktree.lnk\"",
            "    if ((Test-Path $lnk) -and ($shell.CreateShortcut($lnk).TargetPath -like \"$appDir\\*\")) {",
            "        Remove-Item $lnk -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "bin": "disktree.exe",
    "shortcuts": [
        [
            "disktree.exe",
            "..\\disktree"
        ]
    ],
    "checkver": {
        "github": "https://github.com/tobi/disktree"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tobi/disktree/releases/download/v$version/disktree-$version-x86_64-windows.zip",
                "extract_dir": "disktree-$version-x86_64-windows"
            },
            "arm64": {
                "url": "https://github.com/tobi/disktree/releases/download/v$version/disktree-$version-aarch64-windows.zip",
                "extract_dir": "disktree-$version-aarch64-windows"
            }
        }
    }
}

{
    "version": "9.9.31.260528",
    "description": "(NT 版本) QQ，腾讯的一款聊天通讯工具",
    "homepage": "https://im.qq.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://rule.tencent.com/rule/46a15f24-e42c-4cb6-a308-2347139b1201"
    },
    "architecture": {
        "64bit": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.31/release/092069d7/QQ_9.9.31_260528_x64_01.exe#/dl.7z",
            "hash": "0beb5cb4ff776cba822caa0abadbd53f5892f12628a86dabea1b372c82c086bc"
        }
    },
    "extract_dir": "Files",
    "pre_install": [
        "$dataDir = \"$env:PUBLIC\\Documents\\Tencent\\QQ\"",
        "$persistDir = \"$persist_dir\\QQ_Data\"",
        "# 确保 persist 数据目录存在",
        "if (!(Test-Path $persistDir)) {",
        "    New-Item -ItemType Directory $persistDir -Force | Out-Null",
        "}",
        "if (Test-Path $dataDir) {",
        "    Get-ChildItem $dataDir -Directory | ForEach-Object {",
        "        $source = $_.FullName",
        "        $target = Join-Path $persistDir $_.Name",
        "        if ($_.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "            # 删旧 junction（安全：不删目标数据）",
        "            [System.IO.Directory]::Delete($source)",
        "        } elseif (Test-Path $target) {",
        "            # 真实目录 + persist 已有数据 → 合并后删源",
        "            Copy-Item \"$source\\*\" $target -Recurse -Force -ErrorAction SilentlyContinue",
        "            Remove-Item $source -Recurse -Force",
        "        } else {",
        "            # 首次迁移",
        "            Move-Item $source $target",
        "        }",
        "        New-Item -ItemType Junction -Path $source -Target $target | Out-Null",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "# 清理 %PUBLIC%\\Documents\\Tencent\\QQ 下的目录联接，避免残留",
        "$dataDir = \"$env:PUBLIC\\Documents\\Tencent\\QQ\"",
        "if (Test-Path $dataDir) {",
        "    Get-ChildItem $dataDir -Directory -ErrorAction SilentlyContinue | ForEach-Object {",
        "        if ($_.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "            [System.IO.Directory]::Delete($_.FullName)",
        "        }",
        "    }",
        "}"
    ],
    "post_install": [
        "$dataDir = \"$env:PUBLIC\\Documents\\Tencent\\QQ\"",
        "# 确保 QQ 数据父目录存在（子目录由 QQ 运行时创建）",
        "if (!(Test-Path $dataDir)) {",
        "    New-Item -ItemType Directory $dataDir -Force | Out-Null",
        "}"
    ],
    "uninstaller": {
        "script": [
            "# 结束进程（终止后等待文件句柄释放，避免文件锁定导致卸载失败）",
            "Stop-Process -Name QQ -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500"
        ]
    },
    "shortcuts": [
        [
            "QQ.exe",
            "..\\QQ"
        ]
    ],
    "persist": "QQ_Data",
    "checkver": {
        "script": [
            "# 使用腾讯 CDN 查询最新版本",
            "$url = 'https://cdn-go.cn/qq-web/im.qq.com_new/latest/rainbow/windowsConfig.js'",
            "$hostname = ([Uri]$url).Host",
            "$records = Resolve-DnsName 'cdn-go.cn.cloud.tc.qq.com' -Type A -DnsOnly -ErrorAction Ignore",
            "$ip = $records | Where-Object { $_.QueryType -eq 'A' -and $_.IPAddress } | Select-Object -ExpandProperty IP4Address -First 1",
            "$url = $url -Replace [regex]::Escape($hostname), $ip",
            "Invoke-WebRequest -Uri $url -UseBasicParsing -Headers @{'Host' = $hostname} | Select-Object -ExpandProperty Content"
        ],
        "regex": "QQNT/[\\d.]+/([\\w]+)/([\\w]+)/QQ_([\\d.]+)[-_]([\\d]+)_x64_01.exe",
        "replace": "${3}.${4}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNT/$match3/$match1/$match2/QQ_$match3_$match4_x64_01.exe#/dl.7z"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}

{
    "version": "3.9.8",
    "description": "Motrix Next - 全功能下载管理器重构版，支持 HTTP/FTP/SFTP/BitTorrent/Magnet 等多种协议 | A full-featured download manager rebuilt from the ground up",
    "homepage": "https://motrix-next.pages.dev/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnInsomniacy/motrix-next/releases/download/v3.9.8/MotrixNext_3.9.8_x64-setup.exe#/dl.7z",
            "hash": "5059cd7904ee1bd62fdffc69593cff52c8e8f105d6a905e62a1fb2c3950814c8"
        },
        "arm64": {
            "url": "https://github.com/AnInsomniacy/motrix-next/releases/download/v3.9.8/MotrixNext_3.9.8_arm64-setup.exe#/dl.7z",
            "hash": "6571cee336daca568c9562196c4abc7294b73015db6eb0d3067647a42ee1f0ed"
        }
    },
    "pre_install": [
        "$persistDir = \"$persist_dir\\LocalAppData\"",
        "$targetDir = \"$env:LOCALAPPDATA\\com.motrix.next\"",
        "if (!(Test-Path $persistDir)) { New-Item -ItemType Directory $persistDir -Force | Out-Null }",
        "if (Test-Path $targetDir) {",
        "    $item = Get-Item $targetDir -Force -ErrorAction SilentlyContinue",
        "    if ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        [System.IO.Directory]::Delete($targetDir)",
        "    } else {",
        "        Get-ChildItem $targetDir | Move-Item -Destination $persistDir -Force",
        "        Remove-Item $targetDir -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path $targetDir -Target $persistDir | Out-Null"
    ],
    "post_install": [
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall.exe\" -Force -Recurse -ErrorAction Ignore | Out-Null",
        "$persistDir = \"$persist_dir\\LocalAppData\"",
        "$targetDir = \"$env:LOCALAPPDATA\\com.motrix.next\"",
        "if (!(Test-Path $persistDir)) { New-Item -ItemType Directory $persistDir -Force | Out-Null }",
        "if (Test-Path $targetDir) {",
        "    $item = Get-Item $targetDir -Force -ErrorAction SilentlyContinue",
        "    if ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        [System.IO.Directory]::Delete($targetDir)",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path $targetDir -Target $persistDir | Out-Null"
    ],
    "pre_uninstall": [
        "$targetDir = \"$env:LOCALAPPDATA\\com.motrix.next\"",
        "if ((Test-Path $targetDir) -and ((Get-Item $targetDir -Force -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {",
        "    [System.IO.Directory]::Delete($targetDir)",
        "}"
    ],
    "uninstaller": {
        "script": [
            "Stop-Process -Name 'motrix-next' -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500",
            "$appDir = Split-Path $dir -Parent",
            "$shell = New-Object -ComObject WScript.Shell",
            "@(\"$env:APPDATA\", \"$env:ProgramData\") | ForEach-Object {",
            "    $lnk = \"$_\\Microsoft\\Windows\\Start Menu\\Programs\\Motrix Next.lnk\"",
            "    if ((Test-Path $lnk) -and ($shell.CreateShortcut($lnk).TargetPath -like \"$appDir\\*\")) {",
            "        Remove-Item $lnk -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "shortcuts": [
        [
            "motrix-next.exe",
            "..\\Motrix Next"
        ]
    ],
    "checkver": {
        "github": "https://github.com/AnInsomniacy/motrix-next"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnInsomniacy/motrix-next/releases/download/v$version/MotrixNext_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/AnInsomniacy/motrix-next/releases/download/v$version/MotrixNext_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}

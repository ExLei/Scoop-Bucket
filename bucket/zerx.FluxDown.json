{
    "version": "0.1.46",
    "description": "FluxDown - Rust 驱动的多协议下载管理器（便携版）| A modern multi-protocol download manager (Portable)",
    "homepage": "https://fluxdown.zerx.dev",
    "license": {
        "identifier": "Proprietary",
        "url": "https://fluxdown.zerx.dev"
    },
    "architecture": {
        "64bit": {
            "url": "https://fluxdown.zerx.dev/api/download/FluxDown-0.1.46-windows-x64-portable.zip",
            "hash": "d5e6bd6b4eabb690196ecf681bb47fc50377abad80f8d3529288935205d1764b"
        }
    },
    "pre_install": [
        "# 创建空数据库文件占位，确保 persist 将其视为文件而非文件夹",
        "if (!(Test-Path \"$dir\\flux_down.db\")) { New-Item -ItemType File \"$dir\\flux_down.db\" -Force | Out-Null }"
    ],
    "uninstaller": {
        "script": [
            "# 结束进程（终止后等待文件句柄释放，避免文件锁定导致卸载失败）",
            "Stop-Process -Name flux_down -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500",
            "# 清理开始菜单快捷方式残留（校验目标路径指向本应用目录，避免误删同名非 Scoop 快捷方式）",
            "$appDir = Split-Path $dir -Parent",
            "$shell = New-Object -ComObject WScript.Shell",
            "@(\"$env:APPDATA\", \"$env:ProgramData\") | ForEach-Object {",
            "    $lnk = \"$_\\Microsoft\\Windows\\Start Menu\\Programs\\FluxDown.lnk\"",
            "    if ((Test-Path $lnk) -and ($shell.CreateShortcut($lnk).TargetPath -like \"$appDir\\*\")) {",
            "        Remove-Item $lnk -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "shortcuts": [
        [
            "flux_down.exe",
            "..\\FluxDown"
        ]
    ],
    "persist": "flux_down.db",
    "checkver": {
        "url": "https://fluxdown.zerx.dev/api/release",
        "jp": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://fluxdown.zerx.dev/api/download/FluxDown-$version-windows-x64-portable.zip"
            }
        },
        "hash": {
            "mode": "download"
        }
    },
    "notes": [
        "FluxDown 便携版数据持久化说明:",
        "  - 已内置 portable 标记，运行数据自动存储在应用目录",
        "  - 任务记录/配置等核心数据通过 flux_down.db（SQLite）持久化",
        "  - 更新版本时 flux_down.db 会自动保留，下载记录不丢失",
        "",
        "浏览器扩展（需配合本应用使用）:",
        "  Chrome: https://chromewebstore.google.com/detail/fluxdown/meleenglfggcmcajknpeeeiobnpfmahc",
        "  Firefox: https://addons.mozilla.org/zh-CN/firefox/addon/fluxdown",
        "  Edge: https://microsoftedge.microsoft.com/addons/detail/fluxdown/nglkkjbogjghekbhhcnccnpfedjbdhhd"
    ]
}

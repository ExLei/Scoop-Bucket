{
    "version": "1.4.4",
    "description": "Zed Editor (Localized / 汉化版) - 基于 Rust 的高性能代码编辑器汉化版本 | A localized Chinese version of the Zed code editor",
    "homepage": "https://github.com/x6nux/zed-globalization",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/x6nux/zed-globalization/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/x6nux/zed-globalization/releases/download/v1.4.4/zedg-zh-cn-windows-x86_64-v1.4.4.zip",
            "hash": "b1707a0d8c6087900ecedba1d4314de7641e786a8de6a1301768990ecb156487"
        },
        "arm64": {
            "url": "https://github.com/x6nux/zed-globalization/releases/download/v1.4.4/zedg-zh-cn-windows-aarch64-v1.4.4.zip",
            "hash": "b4a6fac12faaa2ca188ccf3fc18bc68df93623993af0e292ff917c42cbaf2055"
        }
    },
    "pre_install": [
        "# 将 %APPDATA%\\Zed 映射到 persist 目录，实现配置/扩展/主题等数据持久化",
        "$appdataDir = \"$env:APPDATA\\Zed\"",
        "$persistAppdata = \"$persist_dir\\appdata\"",
        "# 确保 persist 数据目录存在",
        "if (!(Test-Path $persistAppdata)) {",
        "    New-Item -ItemType Directory $persistAppdata -Force | Out-Null",
        "}",
        "if (Test-Path $appdataDir) {",
        "    if ((Get-Item $appdataDir -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        [System.IO.Directory]::Delete($appdataDir)",
        "    } else {",
        "        Get-ChildItem $appdataDir | Move-Item -Destination $persistAppdata -Force",
        "        Remove-Item $appdataDir -Force -Recurse",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path $appdataDir -Target $persistAppdata | Out-Null",
        "# 将 %LOCALAPPDATA%\\Zed 映射到 persist 目录，实现数据库/缓存/语言服务器等数据持久化",
        "$localDir = \"$env:LOCALAPPDATA\\Zed\"",
        "$persistLocal = \"$persist_dir\\local\"",
        "# 确保 persist 数据目录存在",
        "if (!(Test-Path $persistLocal)) {",
        "    New-Item -ItemType Directory $persistLocal -Force | Out-Null",
        "}",
        "if (Test-Path $localDir) {",
        "    if ((Get-Item $localDir -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        [System.IO.Directory]::Delete($localDir)",
        "    } else {",
        "        Get-ChildItem $localDir | Move-Item -Destination $persistLocal -Force",
        "        Remove-Item $localDir -Force -Recurse",
        "    }",
        "}",
        "New-Item -ItemType Junction -Path $localDir -Target $persistLocal | Out-Null"
    ],
    "pre_uninstall": [
        "# 安全删除目录联接（使用 .NET API，不穿透到目标目录）",
        "$appdataDir = \"$env:APPDATA\\Zed\"",
        "if ((Test-Path $appdataDir) -and ((Get-Item $appdataDir -Force -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {",
        "    [System.IO.Directory]::Delete($appdataDir)",
        "}",
        "$localDir = \"$env:LOCALAPPDATA\\Zed\"",
        "if ((Test-Path $localDir) -and ((Get-Item $localDir -Force -ErrorAction SilentlyContinue).Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {",
        "    [System.IO.Directory]::Delete($localDir)",
        "}"
    ],
    "uninstaller": {
        "script": [
            "# 结束进程（终止后等待文件句柄释放，避免文件锁定导致卸载失败）",
            "Stop-Process -Name ZedG -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500",
            "# 清理开始菜单快捷方式残留（校验目标路径指向本应用目录，避免误删同名非 Scoop 快捷方式）",
            "$appDir = Split-Path $dir -Parent",
            "$shell = New-Object -ComObject WScript.Shell",
            "@(\"$env:APPDATA\", \"$env:ProgramData\") | ForEach-Object {",
            "    $lnk = \"$_\\Microsoft\\Windows\\Start Menu\\Programs\\ZedG.lnk\"",
            "    if ((Test-Path $lnk) -and ($shell.CreateShortcut($lnk).TargetPath -like \"$appDir\\*\")) {",
            "        Remove-Item $lnk -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "bin": [
        [
            "bin\\ZedG.exe",
            "zedg"
        ]
    ],
    "shortcuts": [
        [
            "ZedG.exe",
            "..\\ZedG"
        ]
    ],
    "notes": [
        "ZedG 配置/扩展/主题等数据已持久化：",
        "  - 设置/键映射/主题 → persist\\appdata（映射 %APPDATA%\\Zed）",
        "  - 数据库/扩展索引/语言服务器 → persist\\local（映射 %LOCALAPPDATA%\\Zed）",
        "更新或重装时数据不会丢失。"
    ],
    "checkver": {
        "github": "https://github.com/x6nux/zed-globalization"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/x6nux/zed-globalization/releases/download/v$version/zedg-zh-cn-windows-x86_64-v$version.zip"
            },
            "arm64": {
                "url": "https://github.com/x6nux/zed-globalization/releases/download/v$version/zedg-zh-cn-windows-aarch64-v$version.zip"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}

{
    "version": "1.12.1",
    "description": "Codex++ - OpenAI Codex / ChatGPT 桌面应用的外部启动器与管理工具，支持供应商切换、协议转换、会话管理与界面增强 | An external launcher and management tool for the OpenAI Codex / ChatGPT desktop app",
    "homepage": "https://github.com/BigPizzaV3/CodexPlusPlus",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/BigPizzaV3/CodexPlusPlus/releases/download/v1.12.1/CodexPlusPlus-1.12.1-windows-x64.zip",
            "hash": "da914d518fe154d4ad679e8ac96d54c9fc016e91e0ef02e62dceb641b2c0e414"
        }
    },
    "uninstaller": {
        "script": [
            "Stop-Process -Name 'codex-plus-plus', 'codex-plus-plus-manager' -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500",
            "$appDir = Split-Path $dir -Parent",
            "$shell = New-Object -ComObject WScript.Shell",
            "@(\"$env:APPDATA\", \"$env:ProgramData\") | ForEach-Object {",
            "    @('Codex++.lnk', 'Codex++ 管理工具.lnk') | ForEach-Object {",
            "        $lnk = \"$_\\Microsoft\\Windows\\Start Menu\\Programs\\$_\"",
            "        if ((Test-Path $lnk) -and ($shell.CreateShortcut($lnk).TargetPath -like \"$appDir\\*\")) {",
            "            Remove-Item $lnk -Force -ErrorAction SilentlyContinue",
            "        }",
            "    }",
            "}"
        ]
    },
    "shortcuts": [
        [
            "codex-plus-plus.exe",
            "..\\Codex++"
        ]
    ],
    "checkver": {
        "github": "https://github.com/BigPizzaV3/CodexPlusPlus"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/BigPizzaV3/CodexPlusPlus/releases/download/v$version/CodexPlusPlus-$version-windows-x64.zip"
            }
        }
    }
}

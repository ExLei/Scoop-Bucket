{
    "version": "3.1.0",
    "description": "Watt Toolkit (原名 Steam++) - 开源跨平台的多功能游戏工具箱，集成网络加速、账号切换、库存管理等功能 | An open-source cross-platform multi-purpose game toolkit",
    "homepage": "https://steampp.net",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/BeyondDimension/SteamTools/blob/develop/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/BeyondDimension/SteamTools/releases/download/3.1.0/Steam++_v3.1.0_win_x64.7z",
            "hash": "74d0eb1fd67e8eb0914a9962244fc4251993061df77e6e6c0dfe8a4a899d5ae4"
        }
    },
    "uninstaller": {
        "script": [
            "# 结束进程（终止后等待文件句柄释放，避免文件锁定导致卸载失败）",
            "Stop-Process -Name Steam++ -Force -ErrorAction SilentlyContinue",
            "Start-Sleep -Milliseconds 1500",
            "# 清理开始菜单快捷方式残留（校验目标路径指向本应用目录，避免误删同名非 Scoop 快捷方式）",
            "$appDir = Split-Path $dir -Parent",
            "$shell = New-Object -ComObject WScript.Shell",
            "@(\"$env:APPDATA\", \"$env:ProgramData\") | ForEach-Object {",
            "    $lnk = \"$_\\Microsoft\\Windows\\Start Menu\\Programs\\Steam++.lnk\"",
            "    if ((Test-Path $lnk) -and ($shell.CreateShortcut($lnk).TargetPath -like \"$appDir\\*\")) {",
            "        Remove-Item $lnk -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "bin": "Steam++.exe",
    "shortcuts": [
        ["Steam++.exe", "..\\Steam++"]
    ],
    "persist": "AppData",
    "checkver": {
        "github": "https://github.com/BeyondDimension/SteamTools"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/BeyondDimension/SteamTools/releases/download/$version/Steam++_v$version_win_x64.7z"
            }
        },
        "hash": {
            "mode": "github"
        }
    }
}
